{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "web:demo": "cross-env EXPO_PUBLIC_DEMO_MODE=true expo start --web --clear",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/supabaseRepo.test.ts tests/demoRepo.test.ts tests/format.test.ts",
    "export:web": "expo export --platform web --clear",
    "build:web:demo": "cross-env EXPO_PUBLIC_DEMO_MODE=true expo export --platform web --output-dir dist-demo --clear",
    "smoke:web": "npm run build:web:demo && node scripts/web-smoke.mjs",
    "check:web:prod": "npm run export:web && cross-env SMOKE_DIR=dist SMOKE_EXPECT_SETUP=1 node scripts/web-smoke.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.12",
    "cross-env": "^7.0.3",
    "jsdom": "^24.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
